      "html": "<figure><img src=\"mob:sheep\" alt=\"A sheep\"><figcaption>A sheep</figcaption></figure>\n<figure><img src=\"guide/img/book.png\" alt=\"Book\"><figcaption>Caption <em>here</em></figcaption></figure>\n<figure><img src=\"guide/img/a.png\" alt=\"\"></figure>\n<figure><img src=\"guide/mob:Bad\" alt=\"Odd\"><figcaption>Odd</figcaption></figure>"
